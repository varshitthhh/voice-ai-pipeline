__pycache__/
*.pyc
.venv/
venv/

# session trace logs are regenerated by the harness / scripts, not source
traces/*.jsonl

# fetched/derived corpora, regenerated by scripts/prepare_*.py — not source,
# and SLURP's license is unlisted upstream so its audio isn't redistributed here
data/intent/raw/
data/intent/processed/

# fetched MUSAN noise clips + generated SNR-mixed wavs — regenerated by
# scripts/prepare_musan_noise.py and scripts/snr_sweep.py
data/noise/

# fetched TTS model weights (Kokoro/Piper) — regenerated by scripts/prepare_tts_models.py
data/tts/models/

# synthetic turn-taking scenario audio, derived from SLURP clips (themselves
# gitignored) — regenerated by scripts/prepare_synthetic_turn_taking_eval.py.
# The real corpus goes in data/turn_taking/labels/ (see docs/turn_taking_label_schema.md).
data/turn_taking/synthetic/

# real-audio turn-taking data derived from AMI (cc-by-4.0) and DSTC2 — fetched
# and re-spliced by scripts/prepare_ami_turntaking.py / prepare_dstc2_audio.py.
# Not source, and re-downloadable in minutes; not the real CANDOR/roleplay
# corpus either (see those scripts' docstrings for the honest domain-gap and
# limitation notes).
data/turn_taking/real_ami/
data/turn_taking/dstc2_sample/
